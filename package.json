{
  "name": "studystudio",
  "version": "0.7.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5189 && VITE_DEV_SERVER_URL=http://localhost:5189 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:win": "npm run build && electron-builder --win nsis",
    "rebuild:electron": "electron-builder install-app-deps",
    "rewrite:analyses": "python3 scripts/original/rewrite_seed_analyses.py",
    "export:papers": "python3 scripts/original/export_all_papers.py",
    "patch:question-quality": "ELECTRON_RUN_AS_NODE=1 electron scripts/patch-question-quality.js --seed",
    "audit:question-bank": "ELECTRON_RUN_AS_NODE=1 electron scripts/audit-question-bank.js",
    "tag:skill-points": "ELECTRON_RUN_AS_NODE=1 electron scripts/tag-skill-points.js",
    "obsidian:init": "python obsidian/bridge.py init",
    "obsidian:status": "python obsidian/bridge.py status",
    "obsidian:sync": "python obsidian/bridge.py sync",
    "obsidian:format": "python obsidian/bridge.py format",
    "obsidian:tutor": "python obsidian/bridge.py tutor",
    "obsidian:mindmap": "python obsidian/bridge.py mindmap",
    "obsidian:import": "python obsidian/bridge.py import",
    "obsidian:unimport": "python obsidian/bridge.py unimport",
    "obsidian:all": "python obsidian/bridge.py all",
    "obsidian:latex": "python obsidian/bridge.py latex",
    "obsidian:process": "python obsidian/bridge.py process",
    "obsidian:watch": "python obsidian/bridge.py watch",
    "verify:latex": "node scripts/verify-latex-format.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.8.3",
    "katex": "^0.16.22",
    "openai": "^6.17.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.2",
    "electron-builder": "^26.8.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8",
    "wait-on": "^7.2.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.studystudio.app",
    "productName": "StudyStudio",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "src/main/**/*",
      "src/shared/**/*",
      "src/renderer/assets/openexam-app-icon.png",
      "plugins/**/*",
      "package.json",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.mts",
      "!node_modules/**/*.d.cts",
      "!node_modules/**/*.map",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.mts",
      "!node_modules/**/*.md",
      "!node_modules/katex/dist/katex.mjs",
      "!node_modules/katex/dist/katex.min.js",
      "!node_modules/katex/dist/contrib/**",
      "!node_modules/katex/contrib/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LiAzi-1",
        "repo": "StudyStudio",
        "releaseType": "release"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "extraResources": [
      {
        "from": "data/question-assets",
        "to": "question-assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "obsidian",
        "to": "obsidian",
        "filter": [
          "**/*",
          "!vault/**",
          "!backups/**",
          "!.cache/**",
          "!__pycache__/**",
          "!*.pyc"
        ]
      },
      {
        "from": "scripts/mineru4_extract.py",
        "to": "mineru-scripts/mineru4_extract.py"
      },
      {
        "from": "scripts/python_no_console",
        "to": "mineru-scripts/python_no_console"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  },
  "description": "StudyStudio 考研智能学习平台",
  "author": "lmk1010",
  "license": "GPL-3.0-or-later"
}
